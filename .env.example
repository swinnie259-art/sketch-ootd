# ── Required ─────────────────────────────────────────────
# Claude API key (https://platform.claude.com) — item recognition, pairing advice, re-ranking
ANTHROPIC_API_KEY=

# ── Optional: each platform turns on when its keys are set ─
# YouTube Data API v3 key (Google Cloud Console → APIs & Services → Credentials)
YOUTUBE_API_KEY=

# Instagram Graph API (needs an Instagram Business/Creator account linked to a Facebook Page)
# IG_USER_ID = that account's Instagram user id; IG_ACCESS_TOKEN = long-lived token with
# instagram_basic + pages_read_engagement (and Instagram Public Content Access feature for hashtags)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v21.0

# TikTok Research API (approved researchers only: https://developers.tiktok.com/products/research-api/)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Product photos for the outfit collages (Google Shopping via SerpApi: https://serpapi.com)
# Without it the collages fall back to hand-drawn sketches.
SERPAPI_KEY=
# Which country's shopping results to use (us, uk, jp, hk, ...)
SHOPPING_COUNTRY=us
